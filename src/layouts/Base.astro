---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}
const { title, description = SITE.description, image = '/og.png', imageAlt = 'Lab Notes by Kyle Prins', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={SITE.author}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <meta name="theme-color" content="#1e1b4b">
  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={title ?? SITE.title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:alt" content={imageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <script is:inline>
    try {
      var saved = localStorage.getItem('theme');
      if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="kyleprins.com home">
        <Mark size={36} />
        <span class="wordmark">kyleprins<span class="dot" aria-hidden="true"></span>com</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Lab Notes</a>
        <a href="/lab/" aria-current={path.startsWith('/lab') ? 'page' : undefined}>The Lab</a>
        <a href="/#about">About</a>
        <a href="/rss.xml">RSS</a>
        <a href={SITE.linkedin}>LinkedIn</a>
        <button class="theme-toggle" type="button" aria-label="Switch to dark mode">
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"></path></svg>
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="2" fill="none"></circle><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path></svg>
        </button>
      </nav>
    </div>
  </header>
  <div id="content">
    <slot />
  </div>
  <footer class="site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Kyle Prins · I work at Splunk. Views are my own.</span>
      <nav aria-label="Footer">
        <a href="/rss.xml">RSS</a>
        <a href={SITE.linkedin}>LinkedIn</a>
        <a href="/#about">About</a>
      </nav>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var btn = document.querySelector('.theme-toggle');
      var dark = function () {
        return root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      };
      var label = function () { btn.setAttribute('aria-label', dark() ? 'Switch to light mode' : 'Switch to dark mode'); };
      label();
      btn.addEventListener('click', function () {
        var next = dark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        label();
      });
    })();
  </script>
</body>
</html>
